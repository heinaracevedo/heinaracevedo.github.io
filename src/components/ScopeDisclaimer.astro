---
import type { es } from '../i18n/es';

interface Props {
  t: typeof es;
}

const { t } = Astro.props;
---

<section id="alcance" class="py-12 border-b border-[#1F2937] bg-[#0B0F17]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="p-6 sm:p-7 rounded-lg border border-[#1F2937] bg-[#111827]">
      <div class="flex items-center gap-2.5 font-mono text-xs font-bold text-[#F59E0B] uppercase tracking-wider">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        </svg>
        <span>{t.scope.tag}</span>
      </div>

      <h3 class="mt-2 text-lg sm:text-xl font-bold text-[#F8FAFC]">
        {t.scope.title}
      </h3>

      <p class="mt-3 text-xs sm:text-sm text-[#CBD5E1] leading-relaxed">
        {t.scope.text}
      </p>
    </div>
  </div>
</section>
