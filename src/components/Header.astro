---
import type { es } from '../i18n/es';

interface Props {
  t: typeof es;
  lang: 'es' | 'en';
}

const { t, lang } = Astro.props;
---

<header class="sticky top-0 z-50 w-full bg-[#0B0F17]/90 backdrop-blur-md border-b border-[#1F2937] transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
    <!-- Brand / Technical Identifier -->
    <a href="#inicio" class="flex items-center gap-3 group focus-visible:ring-2 focus-visible:ring-[#38BDF8] rounded-md p-1 -m-1">
      <div class="w-9 h-9 rounded-md bg-[#111827] border border-[#1F2937] group-hover:border-[#0284C7] flex items-center justify-center text-[#38BDF8] font-mono font-bold text-sm tracking-wider transition-colors shadow-sm">
        HA
      </div>
      <div class="flex flex-col">
        <span class="font-bold text-sm text-[#F8FAFC] tracking-tight group-hover:text-[#38BDF8] transition-colors">Heinar Acevedo</span>
        <span class="font-mono text-[11px] text-[#94A3B8] leading-none">POS Ops & Support</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden lg:flex items-center gap-1" aria-label="Navegación principal">
      <a href="#ecosistema" class="px-2.5 py-1.5 text-xs font-medium text-[#CBD5E1] hover:text-[#38BDF8] hover:bg-[#111827] rounded transition-colors">{t.nav.ecosystem}</a>
      <a href="#especialidades" class="px-2.5 py-1.5 text-xs font-medium text-[#CBD5E1] hover:text-[#38BDF8] hover:bg-[#111827] rounded transition-colors">{t.nav.skills}</a>
      <a href="#casos" class="px-2.5 py-1.5 text-xs font-medium text-[#CBD5E1] hover:text-[#38BDF8] hover:bg-[#111827] rounded transition-colors">{t.nav.cases}</a>
      <a href="#trayectoria" class="px-2.5 py-1.5 text-xs font-medium text-[#CBD5E1] hover:text-[#38BDF8] hover:bg-[#111827] rounded transition-colors">{t.nav.experience}</a>
      <a href="#formacion" class="px-2.5 py-1.5 text-xs font-medium text-[#CBD5E1] hover:text-[#38BDF8] hover:bg-[#111827] rounded transition-colors">{t.nav.education}</a>
      <a href="#contacto" class="px-2.5 py-1.5 text-xs font-medium text-[#CBD5E1] hover:text-[#38BDF8] hover:bg-[#111827] rounded transition-colors">{t.nav.contact}</a>
    </nav>

    <!-- Language Switcher & Direct Actions -->
    <div class="flex items-center gap-2.5">
      <!-- Language Switcher Button -->
      <a
        id="langToggle"
        href={t.nav.langTarget}
        aria-label={t.nav.langAria}
        class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded border border-[#1F2937] bg-[#111827] hover:border-[#38BDF8] text-xs font-mono font-semibold text-[#CBD5E1] hover:text-[#38BDF8] transition-colors"
      >
        <span class={lang === 'es' ? 'text-[#38BDF8]' : 'text-[#94A3B8]'}>ES</span>
        <span class="text-[#1F2937]">|</span>
        <span class={lang === 'en' ? 'text-[#38BDF8]' : 'text-[#94A3B8]'}>EN</span>
      </a>

      <!-- Download CV button -->
      <a
        href="/CV-Heinar-Acevedo-Soporte-TI.pdf"
        download="CV-Heinar-Acevedo-Soporte-TI.pdf"
        class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-semibold bg-[#0284C7] hover:bg-[#0369A1] text-[#F8FAFC] transition-colors shadow-sm"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span>{t.nav.downloadCV}</span>
      </a>

      <!-- Mobile Menu Button -->
      <button
        id="mobileMenuBtn"
        type="button"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        class="lg:hidden p-2 rounded-md border border-[#1F2937] bg-[#111827] text-[#CBD5E1] hover:text-[#F8FAFC] hover:border-[#38BDF8] transition-colors"
      >
        <svg id="menuIconClosed" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg id="menuIconOpen" class="w-5 h-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobileMenu" class="hidden lg:hidden border-b border-[#1F2937] bg-[#0B0F17]/98 px-4 py-4 space-y-2">
    <a href="#ecosistema" class="mobile-nav-link block px-3 py-2 text-sm font-medium text-[#CBD5E1] hover:text-[#38BDF8] hover:bg-[#111827] rounded transition-colors">{t.nav.ecosystem}</a>
    <a href="#especialidades" class="mobile-nav-link block px-3 py-2 text-sm font-medium text-[#CBD5E1] hover:text-[#38BDF8] hover:bg-[#111827] rounded transition-colors">{t.nav.skills}</a>
    <a href="#casos" class="mobile-nav-link block px-3 py-2 text-sm font-medium text-[#CBD5E1] hover:text-[#38BDF8] hover:bg-[#111827] rounded transition-colors">{t.nav.cases}</a>
    <a href="#trayectoria" class="mobile-nav-link block px-3 py-2 text-sm font-medium text-[#CBD5E1] hover:text-[#38BDF8] hover:bg-[#111827] rounded transition-colors">{t.nav.experience}</a>
    <a href="#formacion" class="mobile-nav-link block px-3 py-2 text-sm font-medium text-[#CBD5E1] hover:text-[#38BDF8] hover:bg-[#111827] rounded transition-colors">{t.nav.education}</a>
    <a href="#contacto" class="mobile-nav-link block px-3 py-2 text-sm font-medium text-[#CBD5E1] hover:text-[#38BDF8] hover:bg-[#111827] rounded transition-colors">{t.nav.contact}</a>
    <div class="pt-2 border-t border-[#1F2937]">
      <a
        href="/CV-Heinar-Acevedo-Soporte-TI.pdf"
        download="CV-Heinar-Acevedo-Soporte-TI.pdf"
        class="flex items-center justify-center gap-2 w-full py-2.5 rounded-md text-xs font-semibold bg-[#0284C7] text-[#F8FAFC]"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span>{t.nav.downloadCV}</span>
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobileMenuBtn');
  const menu = document.getElementById('mobileMenu');
  const iconClosed = document.getElementById('menuIconClosed');
  const iconOpen = document.getElementById('menuIconOpen');

  btn?.addEventListener('click', () => {
    const isExpanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!isExpanded));
    menu?.classList.toggle('hidden');
    iconClosed?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
  });

  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
      iconClosed?.classList.remove('hidden');
      iconOpen?.classList.add('hidden');
    });
  });

  // Preserve active section hash when switching language
  const langToggle = document.getElementById('langToggle') as HTMLAnchorElement | null;
  if (langToggle) {
    const updateLangHref = () => {
      const base = langToggle.getAttribute('href')?.split('#')[0] || (window.location.pathname.startsWith('/en') ? '/' : '/en/');
      const currentHash = window.location.hash;
      langToggle.href = currentHash ? `${base}${currentHash}` : base;
    };

    updateLangHref();
    window.addEventListener('hashchange', updateLangHref);

    langToggle.addEventListener('click', (e) => {
      const currentHash = window.location.hash;
      if (currentHash) {
        e.preventDefault();
        const base = langToggle.getAttribute('href')?.split('#')[0] || (window.location.pathname.startsWith('/en') ? '/' : '/en/');
        window.location.href = `${base}${currentHash}`;
      }
    });
  }
</script>
