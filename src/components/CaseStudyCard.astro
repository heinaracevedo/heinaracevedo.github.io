---
interface Props {
  caseItem: {
    num: string;
    title: string;
    situation: string;
    intervention: string;
    result: string;
  };
  labels: {
    situation: string;
    intervention: string;
    result: string;
  };
  lang?: 'es' | 'en';
}

const { caseItem, labels, lang = 'es' } = Astro.props;
const toggleLabel = lang === 'es' ? 'Procedimiento técnico y resultado' : 'Technical procedure and outcome';
const expandText = lang === 'es' ? '[ Desplegar ]' : '[ Expand ]';
const collapseText = lang === 'es' ? '[ Colapsar ]' : '[ Collapse ]';
---

<article class="p-6 rounded-lg border border-[#1F2937] bg-[#111827] flex flex-col justify-between">
  <div>
    <!-- Card Header -->
    <div class="flex items-center justify-between pb-3 border-b border-[#1F2937]">
      <span class="font-mono text-xs font-bold text-[#0284C7] bg-[#0B0F17] px-2.5 py-1 rounded border border-[#1F2937]">
        CASO {caseItem.num}
      </span>
      <span class="font-mono text-[11px] text-[#10B981] font-semibold flex items-center gap-1">
        <span class="w-1.5 h-1.5 rounded-full bg-[#10B981]"></span>
        {lang === 'es' ? 'VERIFICADO' : 'VERIFIED'}
      </span>
    </div>

    <h3 class="mt-4 text-base sm:text-lg font-bold text-[#F8FAFC] leading-snug">
      {caseItem.title}
    </h3>

    <!-- Situación: siempre visible -->
    <div class="mt-5 p-3.5 rounded bg-[#0B0F17] border border-[#1F2937]">
      <div class="font-mono text-[11px] font-bold text-[#F59E0B] uppercase tracking-wider">
        {labels.situation}
      </div>
      <p class="mt-1 text-xs sm:text-sm text-[#CBD5E1] leading-relaxed">
        {caseItem.situation}
      </p>
    </div>

    <!-- Procedimiento técnico y resultado: dentro del desplegable (<details> y <summary>) -->
    <details class="group mt-4 rounded border border-[#1F2937] bg-[#0B0F17] overflow-hidden transition-colors open:border-[#38BDF8]/60">
      <summary class="flex items-center justify-between px-3.5 py-2.5 cursor-pointer font-mono text-xs font-semibold text-[#38BDF8] hover:text-[#F8FAFC] hover:bg-[#162032] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#38BDF8] select-none list-none">
        <span class="flex items-center gap-2">
          <svg class="w-3.5 h-3.5 text-[#38BDF8] transition-transform duration-200 group-open:rotate-90 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
          <span>{toggleLabel}</span>
        </span>
        <span class="font-mono text-[10px] text-[#94A3B8] group-open:hidden uppercase">{expandText}</span>
        <span class="font-mono text-[10px] text-[#94A3B8] hidden group-open:inline uppercase">{collapseText}</span>
      </summary>

      <div class="p-3.5 border-t border-[#1F2937] space-y-3.5 text-xs sm:text-sm">
        <!-- Intervención técnica -->
        <div>
          <div class="font-mono text-[11px] font-bold text-[#38BDF8] uppercase tracking-wider">
            {labels.intervention}
          </div>
          <p class="mt-1 text-[#CBD5E1] leading-relaxed">
            {caseItem.intervention}
          </p>
        </div>

        <!-- Resultado documentado -->
        <div class="pt-3 border-t border-[#1F2937]/70">
          <div class="font-mono text-[11px] font-bold text-[#10B981] uppercase tracking-wider">
            {labels.result}
          </div>
          <p class="mt-1 text-[#CBD5E1] leading-relaxed">
            {caseItem.result}
          </p>
        </div>
      </div>
    </details>
  </div>
</article>
