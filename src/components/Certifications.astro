---
import type { es } from '../i18n/es';

interface Props {
  t: typeof es;
}

const { t } = Astro.props;
---

<section id="formacion" class="py-16 md:py-20 border-b border-[#1F2937]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Section Header -->
    <div class="max-w-3xl">
      <div class="font-mono text-xs font-semibold text-[#0284C7] uppercase tracking-wider">{t.certifications.tag}</div>
      <h2 class="mt-2 text-2xl sm:text-3xl font-extrabold text-[#F8FAFC] tracking-tight">{t.certifications.title}</h2>
    </div>

    <!-- Education Card -->
    <div class="mt-10 p-6 sm:p-7 rounded-lg border border-[#1F2937] bg-[#111827]">
      <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 pb-3 border-b border-[#1F2937]">
        <div>
          <span class="font-mono text-[11px] text-[#10B981] font-bold uppercase tracking-wider">Formación Universitaria</span>
          <h3 class="text-lg sm:text-xl font-bold text-[#F8FAFC] mt-1">{t.certifications.education.degree}</h3>
          <div class="text-sm text-[#38BDF8] font-medium mt-0.5">{t.certifications.education.institution}</div>
        </div>
        <span class="font-mono text-xs text-[#94A3B8] bg-[#0B0F17] px-3 py-1.5 rounded border border-[#1F2937] shrink-0">
          {t.certifications.education.period}
        </span>
      </div>
      <p class="mt-3 text-xs sm:text-sm text-[#CBD5E1] leading-relaxed">
        {t.certifications.education.description}
      </p>
    </div>

    <!-- Cisco Networking Academy Courses -->
    <div class="mt-8">
      <div class="p-3.5 rounded-lg border border-[#1F2937] bg-[#0B0F17] text-xs font-mono text-[#94A3B8] mb-4">
        {t.certifications.ciscoNotice}
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {t.certifications.courses.map((course) => (
          <div class="p-6 rounded-lg border border-[#1F2937] bg-[#111827] flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between pb-3 border-b border-[#1F2937]">
                <span class="font-mono text-[11px] text-[#0284C7] font-bold">CISCO ACADEMY</span>
                <span class="font-mono text-[11px] text-[#94A3B8]">{course.date}</span>
              </div>
              <h4 class="mt-3 text-sm sm:text-base font-bold text-[#F8FAFC] leading-snug">{course.title}</h4>
              <div class="mt-1 text-xs font-mono text-[#94A3B8]">{course.issuer}</div>
              <p class="mt-3 text-xs sm:text-sm text-[#CBD5E1] leading-relaxed">{course.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
