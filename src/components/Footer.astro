---
interface Props {
  t: {
    manualVersion: string;
    location: string;
    updated: string;
    rights: string;
  };
}

const { t } = Astro.props;
---

<footer class="border-t border-[var(--color-border)] bg-[var(--color-bg-base)] py-10 px-4 sm:px-6 lg:px-8 text-xs font-mono">
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
    <div class="flex flex-col items-center md:items-start gap-1.5 text-center md:text-left">
      <div class="flex items-center gap-2 text-[var(--color-focus)] font-semibold tracking-wider">
        <span class="inline-block w-2 h-2 rounded-full bg-[var(--color-accent-blue)]"></span>
        <span>{t.manualVersion}</span>
      </div>
      <p class="text-[var(--color-text-secondary)]">{t.location}</p>
    </div>

    <div class="flex flex-col items-center md:items-end gap-1.5 text-center md:text-right text-[var(--color-text-meta)]">
      <div class="flex items-center gap-2">
        <a
          href="https://github.com/heinaracevedo"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-[var(--color-text-secondary)] hover:text-[var(--color-focus)] transition-colors focus-visible:ring-1 focus-visible:ring-[#38BDF8] rounded px-1"
          aria-label="GitHub: @heinaracevedo"
        >
          <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
          </svg>
          <span>github.com/heinaracevedo</span>
        </a>
        <span class="text-[var(--color-border)]">·</span>
        <span>{t.updated}</span>
      </div>
      <span>{t.rights}</span>
    </div>
  </div>
</footer>
