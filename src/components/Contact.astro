---
import type { es } from '../i18n/es';

interface Props {
  t: typeof es;
}

const { t } = Astro.props;
---

<section id="contacto" class="py-16 md:py-20 border-b border-[#1F2937]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Section Header -->
    <div class="max-w-3xl">
      <div class="font-mono text-xs font-semibold text-[#0284C7] uppercase tracking-wider">{t.contact.tag}</div>
      <h2 class="mt-2 text-2xl sm:text-3xl font-extrabold text-[#F8FAFC] tracking-tight">{t.contact.title}</h2>
      <p class="mt-3 text-sm sm:text-base text-[#CBD5E1] leading-relaxed">{t.contact.description}</p>
    </div>

    <!-- Communication Cards Grid -->
    <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <!-- Email Card -->
      <div class="p-5 rounded-lg border border-[#1F2937] bg-[#111827] flex flex-col justify-between">
        <div>
          <div class="w-8 h-8 rounded bg-[#0B0F17] border border-[#1F2937] text-[#38BDF8] flex items-center justify-center mb-3">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </div>
          <div class="font-mono text-[11px] text-[#94A3B8] uppercase">Email Directo</div>
          <div class="text-xs sm:text-sm font-mono font-bold text-[#F8FAFC] mt-1 break-all">{t.contact.email}</div>
        </div>

        <button
          id="copyEmailBtn"
          type="button"
          data-email={t.contact.email}
          class="mt-4 w-full py-2 px-3 rounded border border-[#1F2937] bg-[#0B0F17] hover:border-[#38BDF8] text-xs font-mono text-[#CBD5E1] hover:text-[#38BDF8] transition-colors flex items-center justify-center gap-1.5"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span id="copyBtnText">{t.contact.copyButton}</span>
        </button>
      </div>

      <!-- WhatsApp Card -->
      <a
        href="https://wa.me/529612117910"
        target="_blank"
        rel="noopener noreferrer"
        class="p-5 rounded-lg border border-[#1F2937] bg-[#111827] hover:border-[#10B981] transition-all flex flex-col justify-between group"
      >
        <div>
          <div class="w-8 h-8 rounded bg-[#0B0F17] border border-[#1F2937] group-hover:border-[#10B981] text-[#10B981] flex items-center justify-center mb-3 transition-colors">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8z"></path>
            </svg>
          </div>
          <div class="font-mono text-[11px] text-[#94A3B8] uppercase">WhatsApp</div>
          <div class="text-xs sm:text-sm font-mono font-bold text-[#F8FAFC] mt-1 group-hover:text-[#10B981] transition-colors">{t.contact.whatsapp}</div>
        </div>

        <span class="mt-4 inline-flex items-center gap-1 text-xs font-mono text-[#10B981]">
          {t.contact.openWhatsApp} ›
        </span>
      </a>

      <!-- LinkedIn Card -->
      <a
        href={t.contact.linkedinUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="p-5 rounded-lg border border-[#1F2937] bg-[#111827] hover:border-[#0284C7] transition-all flex flex-col justify-between group"
      >
        <div>
          <div class="w-8 h-8 rounded bg-[#0B0F17] border border-[#1F2937] group-hover:border-[#0284C7] text-[#0284C7] flex items-center justify-center mb-3 transition-colors">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4V8h4v1.5A6 6 0 0 1 16 8z"></path>
              <rect x="2" y="9" width="4" height="12"></rect>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
          </div>
          <div class="font-mono text-[11px] text-[#94A3B8] uppercase">LinkedIn</div>
          <div class="text-xs sm:text-sm font-mono font-bold text-[#F8FAFC] mt-1 group-hover:text-[#0284C7] transition-colors">heinar-acevedo</div>
        </div>

        <span class="mt-4 inline-flex items-center gap-1 text-xs font-mono text-[#0284C7]">
          {t.contact.viewLinkedIn} ›
        </span>
      </a>

      <!-- Download CV Card -->
      <a
        href="/CV-Heinar-Acevedo-Soporte-TI.pdf"
        download="CV-Heinar-Acevedo-Soporte-TI.pdf"
        class="p-5 rounded-lg border border-[#1F2937] bg-[#111827] hover:border-[#38BDF8] transition-all flex flex-col justify-between group"
      >
        <div>
          <div class="w-8 h-8 rounded bg-[#0B0F17] border border-[#1F2937] group-hover:border-[#38BDF8] text-[#38BDF8] flex items-center justify-center mb-3 transition-colors">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
          </div>
          <div class="font-mono text-[11px] text-[#94A3B8] uppercase">Currículum</div>
          <div class="text-xs sm:text-sm font-mono font-bold text-[#F8FAFC] mt-1 group-hover:text-[#38BDF8] transition-colors">PDF (169 KB)</div>
        </div>

        <span class="mt-4 inline-flex items-center gap-1 text-xs font-mono text-[#38BDF8]">
          {t.contact.downloadCV} ›
        </span>
      </a>
    </div>

    <!-- Notification Toast -->
    <div
      id="copyToast"
      role="status"
      aria-live="polite"
      class="fixed bottom-5 left-1/2 -translate-x-1/2 px-4 py-2 rounded-md bg-[#111827] border border-[#10B981] text-[#F8FAFC] text-xs font-mono shadow-lg transition-all opacity-0 pointer-events-none translate-y-3 z-50 flex items-center gap-2"
    >
      <span class="w-2 h-2 rounded-full bg-[#10B981]"></span>
      <span id="toastMsg">{t.contact.copySuccess}</span>
    </div>
  </div>
</section>

<script>
  const copyBtn = document.getElementById('copyEmailBtn');
  const toast = document.getElementById('copyToast');

  copyBtn?.addEventListener('click', () => {
    const email = copyBtn.getAttribute('data-email') || 'heinaromar@gmail.com';
    navigator.clipboard.writeText(email).then(() => {
      if (toast) {
        toast.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-3');
        toast.classList.add('opacity-100', 'translate-y-0');
        setTimeout(() => {
          toast.classList.remove('opacity-100', 'translate-y-0');
          toast.classList.add('opacity-0', 'pointer-events-none', 'translate-y-3');
        }, 2200);
      }
    });
  });
</script>
