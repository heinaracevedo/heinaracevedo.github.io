---
import type { es } from '../i18n/es';

interface Props {
  t: typeof es;
}

const { t } = Astro.props;
---

<section id="trayectoria" class="py-16 md:py-20 border-b border-[#1F2937]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Section Header -->
    <div class="max-w-3xl">
      <div class="font-mono text-xs font-semibold text-[#0284C7] uppercase tracking-wider">{t.experience.tag}</div>
      <h2 class="mt-2 text-2xl sm:text-3xl font-extrabold text-[#F8FAFC] tracking-tight">{t.experience.title}</h2>
    </div>

    <!-- Career Card -->
    <div class="mt-10 p-6 sm:p-8 rounded-lg border border-[#1F2937] bg-[#111827]">
      <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 pb-4 border-b border-[#1F2937]">
        <div>
          <h3 class="text-xl sm:text-2xl font-bold text-[#F8FAFC]">{t.experience.role}</h3>
          <div class="text-sm font-semibold text-[#38BDF8] mt-1">{t.experience.company}</div>
        </div>
        <div class="font-mono text-xs text-[#94A3B8] bg-[#0B0F17] px-3 py-1.5 rounded border border-[#1F2937] shrink-0">
          {t.experience.period}
        </div>
      </div>

      <div class="mt-3 flex items-center gap-2 text-xs font-mono text-[#94A3B8]">
        <svg class="w-3.5 h-3.5 text-[#0284C7]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        <span>{t.experience.location}</span>
      </div>

      <p class="mt-4 text-sm sm:text-base text-[#CBD5E1] leading-relaxed">
        {t.experience.description}
      </p>

      <!-- Highlights -->
      <div class="mt-6 pt-6 border-t border-[#1F2937]">
        <div class="font-mono text-xs font-bold text-[#F59E0B] uppercase tracking-wider mb-3">
          Responsabilidades y Funciones Principales:
        </div>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs sm:text-sm text-[#CBD5E1]">
          {t.experience.highlights.map((item) => (
            <li class="flex items-start gap-2.5">
              <span class="text-[#0284C7] font-mono mt-0.5 font-bold">›</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
