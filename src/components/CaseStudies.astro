---
import type { es } from '../i18n/es';
import CaseStudyCard from './CaseStudyCard.astro';

interface Props {
  t: typeof es;
  lang: 'es' | 'en';
}

const { t, lang } = Astro.props;

const labels = lang === 'es' ? {
  situation: 'Situación',
  intervention: 'Intervención Técnica',
  result: 'Resultado Operativo',
} : {
  situation: 'Situation',
  intervention: 'Technical Intervention',
  result: 'Operational Result',
};
---

<section id="casos" class="py-16 md:py-20 border-b border-[#1F2937]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Section Header -->
    <div class="max-w-3xl">
      <div class="font-mono text-xs font-semibold text-[#0284C7] uppercase tracking-wider">{t.cases.tag}</div>
      <h2 class="mt-2 text-2xl sm:text-3xl font-extrabold text-[#F8FAFC] tracking-tight">{t.cases.title}</h2>
      <p class="mt-3 text-sm sm:text-base text-[#CBD5E1] leading-relaxed">{t.cases.description}</p>
    </div>

    <!-- 3 Cases Grid -->
    <div class="mt-10 grid grid-cols-1 lg:grid-cols-3 gap-6">
      {t.cases.list.map((caseItem) => (
        <CaseStudyCard caseItem={caseItem} labels={labels} lang={lang} />
      ))}
    </div>
  </div>
</section>
