---
import type { es } from '../i18n/es';

interface Props {
  t: typeof es;
}

const { t } = Astro.props;
---

<section id="especialidades" class="py-16 md:py-20 border-b border-[#1F2937]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Section Header -->
    <div class="max-w-3xl">
      <div class="font-mono text-xs font-semibold text-[#0284C7] uppercase tracking-wider">{t.skills.tag}</div>
      <h2 class="mt-2 text-2xl sm:text-3xl font-extrabold text-[#F8FAFC] tracking-tight">{t.skills.title}</h2>
      <p class="mt-3 text-sm sm:text-base text-[#CBD5E1] leading-relaxed">{t.skills.description}</p>
    </div>

    <!-- 4-Quadrant Skills Grid -->
    <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-6">
      {t.skills.categories.map((category, catIdx) => (
        <div class="p-6 rounded-lg border border-[#1F2937] bg-[#111827] flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between pb-3 border-b border-[#1F2937]">
              <h3 class="text-base font-bold text-[#F8FAFC] tracking-tight">{category.title}</h3>
              <span class="font-mono text-xs font-bold text-[#0284C7]">MÓDULO 0{catIdx + 1}</span>
            </div>

            <ul class="mt-4 space-y-2.5">
              {category.items.map((item) => (
                <li class="flex items-start gap-2.5 text-xs sm:text-sm text-[#CBD5E1] leading-relaxed">
                  <span class="text-[#10B981] font-mono mt-0.5 shrink-0 font-bold">✓</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
