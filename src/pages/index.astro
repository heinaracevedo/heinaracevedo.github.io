---
import Layout from '../layouts/Layout.astro';
import { es } from '../i18n/es';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import PosEcosystem from '../components/PosEcosystem.astro';
import SkillsMatrix from '../components/SkillsMatrix.astro';
import CaseStudies from '../components/CaseStudies.astro';
import Experience from '../components/Experience.astro';
import ScopeDisclaimer from '../components/ScopeDisclaimer.astro';
import Certifications from '../components/Certifications.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout lang="es" t={es}>
  <Header t={es} lang="es" />
  <main id="main-content">
    <Hero t={es} />
    <PosEcosystem t={es} />
    <SkillsMatrix t={es} />
    <CaseStudies t={es} lang="es" />
    <Experience t={es} />
    <ScopeDisclaimer t={es} />
    <Certifications t={es} />
    <Contact t={es} />
  </main>
  <Footer t={es.footer} />
</Layout>
